# Optional: enables AI briefings and the "Ask your inventory" chat. Without it, a rules-based summary is used.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5

# Database (defaults to SQLite at backend/inventory.db)
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/inventory

# Scheduled retraining interval in hours (0 disables)
# RETRAIN_INTERVAL_HOURS=24

# Slack-compatible incoming webhook for stockout alerts after each retrain
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
